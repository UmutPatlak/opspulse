# ==============================================
# OpsPulse Root Environment Configuration Example
# Copy this file to .env and adjust values as needed.
# ==============================================

# PostgreSQL Configuration
POSTGRES_DB=opspulse_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379
REDIS_PASSWORD=

# Application
NODE_ENV=development
PORT=3000
