# Server
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/opspulse_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=opspulse_db
DB_SSL=false

# Cache / Message Broker (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_optional

# Security
JWT_SECRET=generate_a_secure_random_jwt_secret_min_32_characters
JWT_EXPIRES_IN=7d
