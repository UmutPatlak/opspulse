# Server
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/opspulse_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=opspulse_db
DB_SSL=false

# Cache / Message Broker (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security
JWT_SECRET=opspulse_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
